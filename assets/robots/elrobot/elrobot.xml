<!-- ElRobot follower arm with its parallel gripper and wrist camera.

     Derived from NormaCore's ElRobot simulation model and STL files
     (https://github.com/norma-core/norma-core, hardware/elrobot, Apache-2.0).
     Changes to the upstream URDF and meshes:
       - converted to MJCF; meshes split into one file per part in its own link frame,
         decimated, and the ST3215 servo instanced from a single mesh
       - collision geometry from a convex decomposition instead of the full visual meshes
       - inertias recomputed (the upstream gripper gear has a zero inertia tensor and
         does not load in MuJoCo), servos weighed at 60 g each
       - joint axes snapped to the exact principal axes (0.5-1.4 deg CAD export tilt);
         link origins and the q = 0 pose are unchanged
       - base frame rotated -90 deg about z: x forward, y left, z up, arm along +x at q = 0
       - jaw coupling reversed so that rev_motor_08 = 0 is closed and 2.2028 is open
       - added the wrist camera: the BOM's arm camera (Innomaker U20CAM-1080P) on
         NormaCore's 27 mm gripper camera mount; the camera body is drawn as a box and a
         cylinder, its intrinsics are nominal (centred principal point)
       - added position actuators with ST3215 gains and the attachment_site at the TCP

     Joint names are NormaCore's, where NN in rev_motor_NN is the ST3215 servo id:
       rev_motor_01..07  shoulder pan, shoulder lift, elbow flex, forearm flex,
                         forearm roll, wrist flex, wrist roll
       rev_motor_08      gripper; the jaws rev_motor_08_1/_2 follow it through equality
                         constraints
     attachment_site sits between the jaw tips, z along the approach direction. -->
<mujoco model="elrobot">
  <compiler angle="radian" meshdir="assets" autolimits="true" />
  <option integrator="implicitfast" />
  <visual>
    <global offwidth="1920" offheight="1080" />
  </visual>
  <default>
    <default class="elrobot">
      <geom solref="0.004 1" friction="1 0.05 0.01" />
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2" />
      </default>
      <default class="collision">
        <geom type="mesh" group="3" rgba="0.8 0.3 0.3 0.4" />
      </default>
    </default>
    <default class="sts3215">
      <joint damping="0.6" frictionloss="0.052" armature="0.028" />
      <position kp="17.8" kv="0.5" forcerange="-3.35 3.35" />
    </default>
    <default class="jaw">
      <joint damping="5" armature="0.001" />
    </default>
  </default>
